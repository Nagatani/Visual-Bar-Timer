{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "visual-bar-timer",
  "version": "1.0.0",
  "identifier": "com.visualbartimer.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Visual Bar Timer",
        "width": 940,
        "height": 520,
        "minWidth": 480,
        "minHeight": 140,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
